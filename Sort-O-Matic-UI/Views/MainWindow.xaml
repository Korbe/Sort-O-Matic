<Window
    x:Class="Sort_O_Matic_UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sort_O_Matic_UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Sort-o-Matic UI"
    Width="400"
    Height="230"
    mc:Ignorable="d">
    <StackPanel>
        <Label
            HorizontalAlignment="Center"
            Content="Sort-O-Matic"
            FontSize="20" />

        <StackPanel
            Margin="5"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Label Content="Source" />
            <TextBox
                Width="200"
                Text="{Binding SourcePath, Mode=TwoWay}"
                ToolTip="{Binding SourcePath}" />
            <Button
                Margin="5,0,0,0"
                Command="{Binding Path=SelectSourceCommand}"
                Content="Browse" />
        </StackPanel>

        <StackPanel
            Margin="5"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Label Content="Target" />
            <TextBox
                Width="200"
                Text="{Binding TargetPath, Mode=TwoWay}"
                ToolTip="{Binding TargetPath}" />
            <Button
                Margin="5,0,0,0"
                Command="{Binding Path=SelectTargetCommand}"
                Content="Browse" />
        </StackPanel>
        <CheckBox
            Margin="5"
            HorizontalAlignment="Center"
            Content="Move instead of copy"
            IsChecked="{Binding IsMove, Mode=TwoWay}" />
        <Button
            Width="200"
            Margin="5,20,0,0"
            Command="{Binding Path=ExecuteCommand}"
            Content="Execute sorting" />
    </StackPanel>
</Window>
